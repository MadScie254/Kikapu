# ───────────────────────────────────────────────────────────
# Kikapu environment variables
# Copy this file to .env for local development (vercel dev / tsx scripts)
# and set the same keys in your Vercel project settings for deployment.
# ───────────────────────────────────────────────────────────

# --- Database (required) ---
# Neon Postgres connection string. Get this from the Vercel Marketplace
# Neon integration, or from https://console.neon.tech -> your project -> Connection Details.
# Use the "pooled" connection string.
DATABASE_URL=postgresql://user:password@host.neon.tech/kikapu?sslmode=require

# --- Auth (required) ---
# Random 32+ byte secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-string

# --- File storage (optional) ---
# Vercel Blob read/write token. If omitted, receipt images are not stored;
# scanning, parsing and saving transactions still work fully without it.
# Create a Blob store in your Vercel project -> Storage -> Blob, then copy the token.
BLOB_READ_WRITE_TOKEN=

# --- Optional AI enhancement (optional, OFF by default) ---
# If set, users can opt in (per-scan) to send a receipt image to Google Gemini
# for higher-accuracy extraction. Without this key the app works completely
# normally using the free, on-device Tesseract.js OCR pipeline.
GEMINI_API_KEY=

# --- Misc ---
# Comma-separated list of origins allowed to call the API in local/dev setups
# that run the client and functions on different ports.
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
