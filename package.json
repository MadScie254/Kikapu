{
  "name": "kikapu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kikapu - Smart receipt scanner and household expense manager (AI-optional)",
  "scripts": {
    "dev": "vercel dev",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "build:client": "npm run build --workspace=client",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace=client",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "workspaces": [
    "client"
  ],
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@vercel/blob": "^0.27.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "jose": "^5.9.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@vercel/node": "^3.2.24",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vercel": "^39.1.3",
    "vitest": "^2.1.8",
    "@playwright/test": "^1.49.1"
  },
  "engines": {
    "node": ">=20"
  }
}
